#. Plugin Name of the plugin
#: headless-reviews-importer.php
msgid "Headless Google/Facebook Reviews Importer"
msgstr "Headless Google/Facebook Reviews Importer"

#. Description of the plugin
#: headless-reviews-importer.php
msgid "Settings page (Facebook/Google keys, import frequency, imported languages, minimum rating), \"Import now\" button, last run display + \"reviews\" custom post type with meta fields and list columns."
msgstr "Beállítási oldal (Facebook/Google kulcsok, importálás gyakorisága, importált nyelvek, legkisebb értékelés), „Importálás most” gomb, az utolsó futás kijelzése, valamint „reviews” egyéni bejegyzéstípus metamezőkkel és listaoszlopokkal."

#. Author of the plugin
#: headless-reviews-importer.php
msgid "Molnár Dávid"
msgstr "Molnár Dávid"

#: headless-reviews-importer.php:187
#: headless-reviews-importer.php:188
#: headless-reviews-importer.php:583
msgid "Reviews Import Settings"
msgstr "Vélemények importálása"

#: headless-reviews-importer.php:207
msgid "Copied"
msgstr "Másolva"

#: headless-reviews-importer.php:208
msgid "Save your changes first."
msgstr "Előbb mentsd a módosításokat."

#: headless-reviews-importer.php:218
msgid "Settings"
msgstr "Beállítások"

#: headless-reviews-importer.php:307
#: headless-reviews-importer.php:402
msgid "Source API"
msgstr "Forrás API"

#: headless-reviews-importer.php:308
msgid "Google Places API key"
msgstr "Google Places API-kulcs"

#: headless-reviews-importer.php:309
msgid "Enable the selected Places API in your Google Cloud project, then create a key for it."
msgstr "Engedélyezd a kiválasztott Places API-t a Google Cloud-projektedben, majd hozz létre hozzá kulcsot."

#: headless-reviews-importer.php:311
msgid "Get an API key (Places API)."
msgstr "API-kulcs igénylése (Places API)."

#: headless-reviews-importer.php:313
msgid "Google Place ID"
msgstr "Google helyazonosító (Place ID)"

#: headless-reviews-importer.php:314
msgid "The ID of the business on Google Maps."
msgstr "A vállalkozás azonosítója a Google Térképen."

#: headless-reviews-importer.php:316
msgid "Place IDs documentation"
msgstr "A Place ID dokumentációja"

#: headless-reviews-importer.php:318
msgid "Import order"
msgstr "Importálás sorrendje"

#: headless-reviews-importer.php:320
msgid "Which reviews Google returns (at most 5): the newest or the most relevant ones."
msgstr "Azt határozza meg, mely véleményeket adja vissza a Google (legfeljebb 5-öt): a legújabbakat vagy a legrelevánsabbakat."

#: headless-reviews-importer.php:323
msgid "Setup guide"
msgstr "Beállítási útmutató"

#: headless-reviews-importer.php:324
msgid "Authorized redirect URI"
msgstr "Engedélyezett átirányítási URI"

#: headless-reviews-importer.php:325
msgid "Business Profile OAuth client ID"
msgstr "Cégprofil OAuth-ügyfélazonosító"

#: headless-reviews-importer.php:326
msgid "Business Profile OAuth client secret"
msgstr "Cégprofil OAuth-ügyféltitok"

#: headless-reviews-importer.php:327
msgid "Google account"
msgstr "Google-fiók"

#: headless-reviews-importer.php:328
msgid "Business Profile location"
msgstr "Cégprofil telephelye"

#: headless-reviews-importer.php:330
msgid "Facebook Page ID"
msgstr "Facebook-oldal azonosítója"

#: headless-reviews-importer.php:331
msgid "Facebook Page Access Token"
msgstr "Facebook-oldal hozzáférési tokenje (Page Access Token)"

#: headless-reviews-importer.php:332
msgid "Connection test"
msgstr "Kapcsolat tesztelése"

#: headless-reviews-importer.php:334
msgid "Import frequency"
msgstr "Importálás gyakorisága"

#: headless-reviews-importer.php:335
msgid "Minimum imported rating"
msgstr "Legkisebb importált értékelés"

#: headless-reviews-importer.php:336
msgid "Imported languages (short codes)"
msgstr "Importált nyelvek (rövid kódok)"

#: headless-reviews-importer.php:337
msgid "Skip empty reviews"
msgstr "Üres vélemények kihagyása"

#: headless-reviews-importer.php:338
msgid "If checked, reviews without a text comment will be skipped."
msgstr "Ha be van jelölve, a szöveg nélküli vélemények kimaradnak."

#: headless-reviews-importer.php:341
msgid "Pre-release updates"
msgstr "Frissítés előzetes kiadásokra"

#: headless-reviews-importer.php:342
msgid "If checked, pre-releases published on GitHub are offered as plugin updates too."
msgstr "Ha be van jelölve, a GitHubon közzétett előzetes kiadások is megjelennek bővítményfrissítésként."

#: headless-reviews-importer.php:359
msgid "Newest"
msgstr "Legújabb"

#: headless-reviews-importer.php:364
msgid "Most Relevant"
msgstr "Legrelevánsabb"

#: headless-reviews-importer.php:384
msgid "Business Profile API (OAuth)"
msgstr "Business Profile API (OAuth)"

#: headless-reviews-importer.php:385
msgid "All reviews of a profile you manage, newest first. Needs an OAuth connection, and Google has to approve Business Profile API access for the Cloud project."
msgstr "Az általad kezelt profil összes véleménye, a legújabbakkal kezdve. OAuth-kapcsolat kell hozzá, és a Google-nek jóvá kell hagynia a Cloud-projekt Business Profile API-hozzáférését."

#: headless-reviews-importer.php:388
msgid "Places API (New)"
msgstr "Places API (New)"

#: headless-reviews-importer.php:389
msgid "Needs an API key and a Place ID. At most 5 reviews, always the most relevant ones (there is no \"newest\" order)."
msgstr "API-kulcs és helyazonosító (Place ID) kell hozzá. Legfeljebb 5 vélemény, mindig a legrelevánsabbak (nincs „legújabb” sorrend)."

#: headless-reviews-importer.php:392
msgid "Places API (Legacy)"
msgstr "Places API (Legacy)"

#: headless-reviews-importer.php:393
msgid "Needs an API key and a Place ID. At most 5 reviews, the newest or the most relevant ones. Can no longer be enabled in new Google Cloud projects."
msgstr "API-kulcs és helyazonosító (Place ID) kell hozzá. Legfeljebb 5 vélemény, a legújabbak vagy a legrelevánsabbak. Új Google Cloud-projektekben már nem engedélyezhető."

#: headless-reviews-importer.php:426
msgid "How to set up the Business Profile API"
msgstr "A Business Profile API beállítása lépésről lépésre"

#: headless-reviews-importer.php:428
msgid "In your Google Cloud project (with approved Business Profile API access) enable: Google My Business API, My Business Account Management API, My Business Business Information API."
msgstr "A Google Cloud-projektedben (amelyhez jóváhagyott Business Profile API-hozzáférés tartozik) engedélyezd a következőket: Google My Business API, My Business Account Management API, My Business Business Information API."

#: headless-reviews-importer.php:429
msgid "Create an OAuth client (type: Web application) with the authorized redirect URI below."
msgstr "Hozz létre egy OAuth-ügyfelet (típus: Webalkalmazás / Web application) a lenti engedélyezett átirányítási URI-val."

#: headless-reviews-importer.php:430
msgid "Save the client ID and client secret, then connect with a Google account that manages the Business Profile."
msgstr "Mentsd el az ügyfélazonosítót és az ügyféltitkot, majd csatlakozz egy olyan Google-fiókkal, amely kezeli a Cégprofilt."

#: headless-reviews-importer.php:431
#: headless-reviews-importer.php:624
msgid "Choose the Business Profile location and save."
msgstr "Válaszd ki a Cégprofil telephelyét, majd mentsd el."

#: headless-reviews-importer.php:444
msgid "Copy"
msgstr "Másolás"

#: headless-reviews-importer.php:457
msgid "Connected"
msgstr "Csatlakoztatva"

#: headless-reviews-importer.php:457
msgid "Not connected"
msgstr "Nincs csatlakoztatva"

