msgstr "Google-fiók csatlakoztatása"

#: headless-reviews-importer.php:641
msgid "Save the OAuth client ID and client secret first."
msgstr "Először mentsd el az OAuth-ügyfélazonosítót és az ügyféltitkot."

#: headless-reviews-importer.php:648
msgid "Fetch locations"
msgstr "Telephelyek lekérése"

#: headless-reviews-importer.php:660
