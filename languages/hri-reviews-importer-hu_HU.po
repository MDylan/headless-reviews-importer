msgstr "OAuth-tokenhiba (%1$s): %2$s"

#. translators: %s: HTTP response code
#: headless-reviews-importer.php:1690
#, php-format
msgid "OAuth token error (%s)"
msgstr "OAuth-tokenhiba (%s)"

#: headless-reviews-importer.php:1710
msgid "Not connected. Connect a Google account on the settings page."
msgstr "Nincs kapcsolat. Csatlakoztass egy Google-fiókot a beállítások oldalon."

#: headless-reviews-importer.php:1779
msgid "Missing or invalid location. Expected format: accounts/{accountId}/locations/{locationId}"
msgstr "Hiányzó vagy érvénytelen telephely. Elvárt formátum: accounts/{accountId}/locations/{locationId}"

#: headless-reviews-importer.php:1855
msgid "Missing OAuth client ID."
msgstr "Hiányzik az OAuth-ügyfélazonosító."

#: headless-reviews-importer.php:1880
msgid "Invalid OAuth state. Start the connection again."
msgstr "Érvénytelen OAuth-állapot (state). Kezdd újra a csatlakozást."

#. translators: %s: error code returned by Google
#: headless-reviews-importer.php:1884
#, php-format
msgid "Google OAuth error: %s"
msgstr "Google OAuth-hiba: %s"

#: headless-reviews-importer.php:1888
msgid "Missing authorization code."
msgstr "Hiányzik az engedélyezési kód."

#: headless-reviews-importer.php:1897
msgid "Google did not return a refresh token."
msgstr "A Google nem küldött frissítési tokent (refresh token)."

#: headless-reviews-importer.php:1962
msgid "No Business Profile locations found for this Google account."
msgstr "Ehhez a Google-fiókhoz nem található Cégprofil-telephely."

#: headless-reviews-importer.php:2138
msgid "Could not rename the folder of the downloaded update."
msgstr "A letöltött frissítés mappáját nem sikerült átnevezni."

