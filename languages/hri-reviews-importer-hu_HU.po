msgid "Business Profile OAuth client secret"
msgstr "Cégprofil OAuth-ügyféltitok"

#: headless-reviews-importer.php:243
msgid "Google account connection"
msgstr "Google-fiók kapcsolata"

#: headless-reviews-importer.php:259
msgid "Headless Reviews Importer:"
msgstr "Headless Reviews Importer:"

#. translators: %s: list of the stored secrets, e.g. "Google Places API key, Google account connection"
#: headless-reviews-importer.php:261
#, php-format
msgid "These stored values cannot be decrypted: %s. Reviews are not imported from Google until this is fixed."
msgstr "Ezek a tárolt adatok nem fejthetők vissza: %s. Amíg ez így marad, a Google-vélemények importja nem fut."

#: headless-reviews-importer.php:262
msgid "The encryption key in wp-config.php (HRI_ENCRYPTION_KEY, or AUTH_KEY and SECURE_AUTH_KEY) has changed, or the database comes from another site. Enter the key or the client secret again, and reconnect the Google account if it is affected."
msgstr "Megváltozott a wp-config.php titkosítási kulcsa (HRI_ENCRYPTION_KEY, illetve AUTH_KEY és SECURE_AUTH_KEY), vagy az adatbázis másik oldalról jött. Add meg újra a kulcsot vagy az ügyféltitkot, és ha a Google-fiók kapcsolata is érintett, csatlakoztasd újra a fiókot."

#: headless-reviews-importer.php:264
#: headless-reviews-importer.php:282
#: headless-reviews-importer.php:283
#: headless-reviews-importer.php:662
msgid "Reviews Import Settings"
msgstr "Vélemények importálása"

#: headless-reviews-importer.php:302
msgid "Copied"
msgstr "Másolva"

#: headless-reviews-importer.php:303
msgid "Save your changes first."
msgstr "Előbb mentsd a módosításokat."

#: headless-reviews-importer.php:313
msgid "Settings"
msgstr "Beállítások"

#: headless-reviews-importer.php:397
#: headless-reviews-importer.php:488
msgid "Source API"
msgstr "Forrás API"

#: headless-reviews-importer.php:399
msgid "Enable the selected Places API in your Google Cloud project, then create a key for it."
msgstr "Engedélyezd a kiválasztott Places API-t a Google Cloud-projektedben, majd hozz létre hozzá kulcsot."

#: headless-reviews-importer.php:401
msgid "Get an API key (Places API)."
msgstr "API-kulcs igénylése (Places API)."

#: headless-reviews-importer.php:403
msgid "Google Place ID"
msgstr "Google helyazonosító (Place ID)"

#: headless-reviews-importer.php:404
msgid "The ID of the business on Google Maps."
msgstr "A vállalkozás azonosítója a Google Térképen."

#: headless-reviews-importer.php:406
msgid "Place IDs documentation"
msgstr "A Place ID dokumentációja"

#: headless-reviews-importer.php:408
msgid "Import order"
msgstr "Importálás sorrendje"

#: headless-reviews-importer.php:410
msgid "Which reviews Google returns (at most 5): the newest or the most relevant ones."
msgstr "Azt határozza meg, mely véleményeket adja vissza a Google (legfeljebb 5-öt): a legújabbakat vagy a legrelevánsabbakat."

#: headless-reviews-importer.php:413
msgid "Setup guide"
msgstr "Beállítási útmutató"

#: headless-reviews-importer.php:414
msgid "Authorized redirect URI"
msgstr "Engedélyezett átirányítási URI"

